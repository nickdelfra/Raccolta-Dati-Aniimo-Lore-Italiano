<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lore di Aniimo — La storia e i capitoli del mondo di gioco</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a1322; --bg-panel:#111f33; --bg-panel-2:#0d1a2b;
    --gold:#d3b36a; --gold-soft:#8d7239; --text:#e9e4d6; --text-dim:#9fb0c3;
    --border:rgba(211,179,106,0.25); --radius:8px; --maxw:760px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0; background:var(--bg); color:var(--text); font-family:'EB Garamond', serif; font-size:18px; line-height:1.75;}
  .font-display{font-family:'Cinzel', serif; letter-spacing:.04em;}
  #scrollProgress{position:fixed; top:0; left:0; height:3px; width:0%; background:linear-gradient(90deg, var(--gold-soft), var(--gold)); z-index:200; transition:width .1s linear;}
  .topbar{position:sticky; top:0; z-index:100; background:rgba(10,19,34,.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--border); display:flex; align-items:center; gap:1rem; padding:.6rem 1rem;}
  .brand{font-family:'Cinzel', serif; color:var(--gold); font-weight:600; letter-spacing:.12em; font-size:.95rem; white-space:nowrap;}
  .chapter-nav{display:flex; gap:.3rem; overflow-x:auto; scrollbar-width:none; flex:1;}
  .chapter-nav::-webkit-scrollbar{display:none;}
  .chapter-nav a{font-family:'Cinzel', serif; font-size:.72rem; letter-spacing:.05em; color:var(--text-dim); text-decoration:none; text-transform:uppercase; padding:.4rem .6rem; border-radius:20px; white-space:nowrap; border:1px solid transparent;}
  .chapter-nav a:hover{color:var(--gold);}
  .chapter-nav a.active{color:var(--gold); border-color:var(--border); background:var(--bg-panel);}
  .hero{text-align:center; max-width:var(--maxw); margin:0 auto; padding:4rem 1.25rem 1.5rem;}
  .kicker{font-style:italic; color:var(--text-dim); margin:0 0 .6rem;}
  .hero h1{font-size:2.8rem; margin:.2rem 0 .6rem; color:var(--gold);}
  .hero .subtitle{color:var(--text-dim); font-style:italic; margin:0 0 1.2rem;}
  .credit{font-size:.95rem; color:var(--text-dim);}
  .credit strong{color:var(--text);}
  .socials{margin-top:.4rem; font-size:.9rem;}
  .socials a{color:var(--gold-soft); text-decoration:none; border-bottom:1px dotted var(--gold-soft); margin:0 .3rem;}
  .socials a:hover{color:var(--gold);}
  .intro{max-width:var(--maxw); margin:0 auto; padding:0 1.25rem 2rem; border-bottom:1px solid var(--border);}
  .intro p{color:var(--text);}
  .chapter{max-width:var(--maxw); margin:0 auto; padding:3.2rem 1.25rem; border-bottom:1px solid var(--border);}
  .chapter-label{font-family:'Cinzel', serif; font-size:.78rem; letter-spacing:.2em; color:var(--gold-soft); text-transform:uppercase; margin:0 0 .4rem;}
  .chapter-title{font-family:'Cinzel', serif; font-size:2.1rem; color:var(--gold); margin:0 0 2rem;}
  .chapter p{margin:1.1rem 0;}
  figure.illustration{margin:2.2rem 0;}
  figure.illustration img{width:100%; display:block; border-radius:var(--radius); border:1px solid var(--border);}
  .img-ph{width:100%; aspect-ratio:16/10; border-radius:var(--radius); border:1px dashed var(--border); background:repeating-linear-gradient(135deg, var(--bg-panel), var(--bg-panel) 14px, var(--bg-panel-2) 14px, var(--bg-panel-2) 28px); display:flex; align-items:center; justify-content:center; padding:1.2rem; text-align:center; color:var(--text-dim); font-size:.85rem; font-style:italic; line-height:1.5;}
  figcaption{margin-top:.7rem; font-size:.95rem; color:var(--text-dim);}
  figcaption strong{display:block; margin-bottom:.25rem; font-family:'Cinzel', serif; font-size:.82rem; letter-spacing:.04em; text-transform:uppercase; color:var(--gold);}
  .callout{border:1px solid var(--gold-soft); background:var(--bg-panel); border-radius:var(--radius); padding:.9rem 1.1rem; font-style:italic; color:var(--gold); margin:0 0 1.6rem;}
  .glossary dl{display:grid; gap:1.1rem; margin:0;}
  .glossary dt{font-family:'Cinzel', serif; color:var(--gold); font-size:1rem; letter-spacing:.02em;}
  .glossary dd{margin:.2rem 0 0; color:var(--text-dim);}
  .sources ul{padding-left:1.1rem; color:var(--text-dim); font-size:.95rem;}
  .sources h3{font-family:'Cinzel', serif; color:var(--gold); font-size:1.1rem; margin:1.6rem 0 .6rem;}
  .sources p{color:var(--text-dim); font-size:.95rem;}
  footer.site-footer{text-align:center; padding:2.5rem 1rem 8rem; color:var(--text-dim); font-family:'Cinzel', serif; font-size:.8rem; letter-spacing:.1em; text-transform:uppercase;}
  .player{position:fixed; right:1rem; bottom:1rem; z-index:150; background:var(--bg-panel); border:1px solid var(--border); border-radius:12px; padding:.7rem .9rem; display:flex; align-items:center; gap:.7rem; box-shadow:0 12px 30px rgba(0,0,0,.45); max-width:300px;}
  .player button.play{width:36px; height:36px; border-radius:50%; flex:none; border:1px solid var(--gold-soft); background:transparent; color:var(--gold); font-size:.9rem; cursor:pointer; display:flex; align-items:center; justify-content:center;}
  .player button.play:hover{background:var(--bg-panel-2);}
  .player-body{flex:1; min-width:0;}
  .track-title{font-family:'Cinzel', serif; font-size:.72rem; letter-spacing:.04em; color:var(--gold); text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:.3rem;}
  .player input[type=range]{width:100%; accent-color:var(--gold); height:3px; margin:0;}
  .time{font-size:.68rem; color:var(--text-dim); display:block; margin-top:.2rem;}
  .volume-wrap{width:50px; flex:none;}
  @media (max-width:560px){.hero h1{font-size:2.1rem;} .chapter-title{font-size:1.6rem;} .player{left:1rem; right:1rem; max-width:none;}}
</style>
</head>
<body>

