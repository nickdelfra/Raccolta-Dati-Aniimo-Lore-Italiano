</main>

<footer class="site-footer">Lore di Aniimo · prima edizione in italiano</footer>

<audio id="bgAudio" src="assets/audio/malo-march-of-progress.mp3" preload="none" loop></audio>
<div class="player">
  <button class="play" id="playBtn" aria-label="Riproduci/Pausa">▶</button>
  <div class="player-body">
    <div class="track-title">MALO · March of Progress</div>
    <input type="range" id="seek" value="0" min="0" max="100" step="0.1">
    <span class="time" id="timeLabel">0:00 / 0:00</span>
  </div>
  <div class="volume-wrap">
    <input type="range" id="volume" min="0" max="1" step="0.01" value="0.7" aria-label="Volume">
  </div>
</div>

<script>
  const progressBar = document.getElementById('scrollProgress');
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const pct = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
    progressBar.style.width = pct + '%';
  });

  document.querySelectorAll('figure.illustration img').forEach(img => {
    img.addEventListener('error', () => {
      const ph = document.createElement('div');
      ph.className = 'img-ph';
      ph.textContent = img.alt;
      img.replaceWith(ph);
    });
  });

  const navLinks = document.querySelectorAll('#chapterNav a');
  const map = {};
  navLinks.forEach(a => map[a.getAttribute('href').slice(1)] = a);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = entry.target.id;
      if (map[id] && entry.isIntersecting) {
        navLinks.forEach(a => a.classList.remove('active'));
        map[id].classList.add('active');
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px' });

  document.querySelectorAll('main section[id]').forEach(s => observer.observe(s));

  const audio = document.getElementById('bgAudio');
  const playBtn = document.getElementById('playBtn');
  const seek = document.getElementById('seek');
  const volume = document.getElementById('volume');
  const timeLabel = document.getElementById('timeLabel');

  function formatTime(t){
    if (isNaN(t)) return '0:00';
    const m = Math.floor(t/60);
    const s = Math.floor(t%60).toString().padStart(2,'0');
    return `${m}:${s}`;
  }

  playBtn.addEventListener('click', () => {
    if (audio.paused){ audio.play(); playBtn.textContent = '❚❚'; }
    else { audio.pause(); playBtn.textContent = '▶'; }
  });

  audio.addEventListener('timeupdate', () => {
    if (audio.duration){
      seek.value = (audio.currentTime / audio.duration) * 100;
      timeLabel.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
    }
  });

  seek.addEventListener('input', () => {
    if (audio.duration){
      audio.currentTime = (seek.value / 100) * audio.duration;
    }
  });

  volume.addEventListener('input', () => {
    audio.volume = volume.value;
  });
  audio.volume = volume.value;
</script>

</body>
</html>
